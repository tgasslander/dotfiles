**/*/tmux/plugins/**
**/*/nvim/plugin/**
**/*/nvim/lazy-lock.json
**/*/node_modules/**
**/*/yarn-error.log
**/*/yarn.lock

# uv's installer drops ~55MB of prebuilt binaries into the stowed scripts
# package; install uv via env-install instead of committing them.
scripts/.local/bin/uv
scripts/.local/bin/uvx

# oh-my-posh (omp, ~175MB) and rtk are prebuilt binaries; install them via
# env-install instead of committing them (same policy as uv/uvx above).
scripts/.local/bin/omp
scripts/.local/bin/rtk
